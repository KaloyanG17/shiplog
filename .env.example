# Copy this file to `.env` and fill in the values. Never commit `.env`.

# PostgreSQL connection string (local Postgres, Neon, or Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shiplog"

# Session encryption secret. Generate one with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:      http://localhost:3000
#   Callback URL:      http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# GitHub App (reads your repos): https://github.com/settings/apps -> New GitHub App
#   Setup URL: http://localhost:3000/api/github/setup  (tick "Redirect on update")
# GITHUB_APP_SLUG is the last part of the app's public URL: github.com/apps/<slug>
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
# The downloaded .pem file on one line, with each line break written as \n
GITHUB_APP_PRIVATE_KEY=""

# GitHub App webhooks. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and paste the same value into the GitHub App's "Webhook secret" field.
GITHUB_WEBHOOK_SECRET=""
# Local development only: a https://smee.io channel that forwards webhooks to
# localhost (`npm run webhooks:dev` prints a fresh one if this is empty).
SMEE_URL=""

# Only needed when running a production build outside Vercel (`npm run build && npm start`).
# `npm run dev` and Vercel trust the host automatically.
# AUTH_TRUST_HOST=true
